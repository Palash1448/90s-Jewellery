rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requester is an authenticated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@90schyaathavanijewellery\\.com$') ||
        request.auth.token.email.matches('.*@kalyanijewels\\.com$') ||
        request.auth.uid != null
      );
    }

    // Products collection:
    // - Public can read active products
    // - Only admin can create, update, delete or read inactive/draft products
    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    // Orders collection:
    // - Public can create a new order (with pending payment status)
    // - Public can read a specific order if looking up their confirmation
    // - Only admin or server cloud functions can update status or read list of all orders
    match /orders/{orderId} {
      allow create: if request.resource.data.paymentStatus == 'pending' && request.resource.data.orderStatus == 'new';
      allow get: if true; // allow fetching the confirmation page for this order
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Customers collection:
    // - Public can create/update their own customer entry during checkout
    // - Only admin can list or view customer directory
    match /customers/{customerId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // Addresses collection:
    // - Public can create address during checkout
    // - Only admin can list all addresses
    match /addresses/{addressId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Settings collection:
    // - Public can read store profile, shipping rules & policies
    // - Only admin can modify settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
