rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requester is an authenticated admin user
    function isAdmin() {
      return request.auth != null;
    }

    // Products collection:
    // - Public can view products
    // - Authenticated admin can create, update, and delete products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection:
    // - Public can create orders during checkout and read specific order receipts
    // - Authenticated admin can view all orders, update status, and manage records
    match /orders/{orderId} {
      allow create, get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Customers collection:
    // - Public can create or update their profile on order
    // - Authenticated admin can view and manage customer directory
    match /customers/{customerId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // Addresses collection:
    // - Public can create shipping address on checkout
    // - Authenticated admin can manage addresses
    match /addresses/{addressId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Settings collection:
    // - Public can read store profile, WhatsApp numbers & shipping settings
    // - Authenticated admin can update settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
